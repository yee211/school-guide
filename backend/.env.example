# PostgreSQL 连接使用 psycopg DSN，不要使用 postgresql+psycopg:// 前缀。
POSTGRES_DSN=postgresql://postgres:your_password@127.0.0.1:5432/postgres
POSTGRES_CONNECT_TIMEOUT=5

# Redis（结构化查询缓存）
REDIS_URL=redis://:your_password@127.0.0.1:6379/0

# OpenAI-compatible LLM API
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=

# OpenAI-compatible embedding API
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_BASE_URL=

# 千问云端 Rerank API（重排序，无需本地模型）
# 注意：rerank 接口路径是 compatible-api/v1（不是 compatible-mode/v1）
RERANKER_API_KEY=
RERANKER_MODEL_ID=qwen3-rerank
RERANKER_BASE_URL=
