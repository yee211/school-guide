# ============ 复制本文件为 .env 并填入真实值 ============
# cp .env.example .env

# 数据库密码（docker-compose 中 PostgreSQL 使用）
POSTGRES_PASSWORD=your_password

# ---- 生成模型（路由 agent / 回答生成）----
LLM_API_KEY="sk-your-llm-api-key"
LLM_MODEL_ID="deepseek-v4-flash"
LLM_BASE_URL="https://api.deepseek.com/v1"
# 意图识别专用模型（可选，默认与生成模型相同）
# INTENT_LLM_MODEL_ID=

# ---- Embedding ----
EMBEDDING_API_KEY="sk-your-embedding-api-key"
EMBEDDING_MODEL_ID="qwen3.7-text-embedding"
EMBEDDING_BASE_URL="https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# ---- Rerank（千问云端 Rerank API）----
RERANKER_API_KEY="sk-your-rerank-api-key"
RERANKER_MODEL_ID="qwen3-rerank"
RERANKER_BASE_URL="https://dashscope.aliyuncs.com/compatible-api/v1"

# ---- 可选：检索参数（有默认值，不改可不填）----
SEMANTIC_RECALL_K=15
BM25_RECALL_K=15
HYBRID_CANDIDATE_COUNT=30
STRUCTURED_CACHE_TTL=3600